# ─────────────────────────────────────────────────────────────────────────────
# REA workspace: only OUR work goes into git (docs/, tools/, CLAUDE.md...).
# Reference projects, console dumps and analysis outputs stay out.
# ─────────────────────────────────────────────────────────────────────────────

# ── Reference material (third-party code/artifacts; we study it, we do not version it) ──
/ref/

# ── PRIVATE content: ROMs/dumps from your Switch (never commit, never publish) ──
# Only the empty marker is kept so the folder exists in a clone; all content stays ignored.
/roms/*
!/roms/.gitkeep
# Old names: keep them ignored so a copy that is still being moved does not leak.
/Pokémon Violet/
/Pokemon Violet/
/Pokémon Scarlet/
/Pokemon Scarlet/
/dumps/
# Switch game/system formats, in any folder
*.xci
*.xcz
*.nsp
*.nsz
*.nca
*.ncz
*.nso
*.nro
*.npdm
*.kip
*.ticket
*.tik
*.cert
# console keys (keep them in /keys/): only the empty marker is tracked, never the content
/keys/*
!/keys/.gitkeep
prod.keys
title.keys
dev.keys
*.keys
# content extracted from the game (exefs/romfs) and everything derived from it
extracted/
exefs/
romfs/
**/generated/
**/generated-*/
# Ghidra/IDA/REA outputs on the game (they contain Nintendo/Game Freak code/names)
*.gpr
*.rep/
*.i64
*.idb
*.reasnap

# ── Lab: targets, snapshots and raw worker reports ──
/lab/

# ── Machine tools, environments and caches ──
.venv/
venv/
__pycache__/
*.pyc
node_modules/
build/
/cache/
*.log
*.log.jsonl

# ── Editor / SO ──
/.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# raw worker outputs (what is accepted goes into the project)
/work/out/
/hactoolnet/

# Compatibility with old Eden copies outside /ref/ (never in git)
Eden-Windows-*/
Eden-Windows/
# External binary used only for dump extraction
/tools/hactoolnet/
